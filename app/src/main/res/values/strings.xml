    <!-- Help screen -->
    <string name="help_title">Help</string>
    <string name="help_s1_title">1. Pick a template</string>
    <string name="help_s1_body">Open Templates from the side menu and swipe through the styles. Tap \'Use template\' on the card you like to start composing.</string>
    <string name="help_s2_title">2. Type your text</string>
    <string name="help_s2_body">Type or paste any text into the field. Line breaks and punctuation are preserved as you wrote them.</string>
    <string name="help_s3_title">3. Generate</string>
    <string name="help_s3_body">Tap Generate. HandType lays out your text glyph-by-glyph, varying spacing, rotation and pressure so each note looks naturally hand-written.</string>
    <string name="help_s4_title">4. Save, share or export</string>
    <string name="help_s4_body">From the result screen you can save the note as a PNG to your gallery, save without the paper background as a transparent PNG, share to any app, or export as a multi-page PDF.</string>
    <string name="help_s5_title">5. History</string>
    <string name="help_s5_body">Every generated note is automatically archived. Open History from the side menu to revisit, re-export, share or delete past notes.</string>

    <!-- FAQ screen -->
    <string name="faq_title">FAQ</string>
    <string name="faq_q1">Where are saved files stored?</string>
    <string name="faq_a1">PNGs are saved to Pictures/HandType. PDFs are saved to Download/HandType on Android 10 and newer. On older Android versions, share the PDF to save a copy. Saving PNGs on Android 9 and older requires storage permission.</string>
    <string name="faq_q2">What is the transparent PNG for?</string>
    <string name="faq_a2">It\'s the same handwriting without the paper background, useful when you want to drop the note onto another image, document or slide.</string>
    <string name="faq_q3">Can a long note span multiple PDF pages?</string>
    <string name="faq_a3">Yes. The PDF export paginates automatically and snaps page breaks to whitespace between text rows so no character gets clipped.</string>
    <string name="faq_q4">Why does a glyph look slightly off?</string>
    <string name="faq_a4">Each character is composed from one of several stored variants and is then rotated, jittered and re-weighted to mimic real handwriting variation.</string>
    <string name="faq_q5">What does the History screen actually keep?</string>
    <string name="faq_a5">A private copy of every generated note plus the source text. Nothing is uploaded; deleting an entry removes the on-device copy only.</string>
    <string name="faq_q6">How does personal handwriting capture work?</string>
    <string name="faq_a6">You fill out the practice sheet, scan it, and HandType builds a personal template from your handwriting. The capture runs on-device with ML Kit; nothing leaves the phone.</string>

